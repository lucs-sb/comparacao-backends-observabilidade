# Versões fixadas de todas as ferramentas, lidas pelo orquestrador e pelos arquivos compose.
# Os seis backends estão na última versão estável de outubro de 2026. O Collector e o
# telemetrygen estão na mesma versão do Collector da OpenTelemetry Demo 3.1.0.
ES_VERSION=9.5.5
LOKI_VERSION=3.7.8
PROM_VERSION=v3.13.3
VM_VERSION=v1.154.0
JAEGER_VERSION=2.21.0
ZIPKIN_VERSION=3.6.1
OTELCOL_VERSION=0.159.0
AVALANCHE_VERSION=v0.7.0
TELEMETRYGEN_VERSION=v0.159.0
# DEMO_VERSION fixa as imagens da Demo, e DEMO_TAG, a tag do repositório clonado
DEMO_VERSION=3.1.0
# o flog não tem versões marcadas, então a imagem é fixada pelo digest
FLOG_IMAGE=mingrammer/flog@sha256:44180f8610fab7d4c29ff233a79e19cf28bd425c1737aa59c72c1f66613fdf41
LOCUST_VERSION=2.46.7
CADVISOR_VERSION=v0.55.1
DEMO_TAG=3.1.0
