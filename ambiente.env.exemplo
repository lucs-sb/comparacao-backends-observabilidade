# Exemplo do ambiente.env, o arquivo que liga o orquestrador às instâncias da AWS.
# Copie para ambiente.env na raiz do repositório das instâncias e troque os IPs pelos IPs
# privados de cada uma. O ambiente.env fica fora do git. Sem ele, tudo roda na máquina
# local, com os limites de memória padrão dos arquivos compose.

# IPs privados das instâncias
IP_BACKEND=172.31.0.11    # instância 1: backends
IP_DEMO=172.31.0.12       # instância 2: Collector isolado e OpenTelemetry Demo
IP_CARGA=172.31.0.13      # instância 3: orquestrador e geradores

# Memória dos backends de logs e de métricas (Loki, Prometheus e VictoriaMetrics)
BACKEND_MEM=12g

# Elasticsearch no par de logs: contêiner e heap da JVM
ES_MEM_LOGS=12g
ES_HEAP_LOGS=6g

# Par de traces: o Elasticsearch divide a instância com o Jaeger ou o Zipkin
ES_MEM_TRACES=8g
ES_HEAP_TRACES=4g
TRACES_MEM=4g             # Jaeger ou Zipkin
ZIPKIN_HEAP=3g

# Collector isolado e Collector da Demo. O GOMEMLIMIT do Collector da Demo fica em 80% disto.
COLLECTOR_MEM=8G
